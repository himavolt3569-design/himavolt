# =============================================================================
# HimaVolt / HimalHub — environment template
# =============================================================================
# Copy to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# This file is the CONTRACT. It is committed on purpose (see the `!.env.example`
# negation in .gitignore) so that a lost machine never again means a lost
# understanding of what this app needs to boot.
#
# Never put a real secret in this file.
#
# Recovery instructions for every variable below live in:
#     docs/10-env-recovery.md
#
# Verified against the live Vercel project on 2026-08-16 (24 vars set in
# Production + Preview, all flagged "Sensitive" and therefore write-only).
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the app will not boot or will misbehave without these
# -----------------------------------------------------------------------------

# Supabase Postgres, POOLED (Supavisor transaction mode, port 6543).
# Every runtime query goes through this. Must include ?pgbouncer=true.
#   Source: Supabase dashboard -> Project Settings -> Database -> Connection string -> Transaction
#   Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase Postgres, DIRECT (session mode, port 5432).
# Used ONLY by `prisma db push` in scripts/vercel-build.mjs. Never at runtime —
# the pooler rejects session-mode DDL with MaxClientsInSessionMode.
#   Source: same page -> Connection string -> Session
#   Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Absolute public URL of the app, no trailing slash.
# Payment callback + return URLs are built off this. If it is wrong, eSewa and
# Khalti redirect customers into the void after they have already paid.
#   Production: https://www.himavolt.com
#   Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Supabase -----------------------------------------------------------------
# Auth (cookie sessions via @supabase/ssr), Storage, and Realtime broadcast.

#   Source: Supabase dashboard -> Project Settings -> API -> Project URL
#   Production value: https://fmqtvtqbjoepcnctmdyk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

#   Source: Supabase dashboard -> Project Settings -> API -> anon / public
#   Safe to expose — it ships in the client bundle by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

#   Source: Supabase dashboard -> Project Settings -> API -> service_role
#   SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
#   Used by the Realtime broadcast endpoint and storage uploads.
SUPABASE_SERVICE_ROLE_KEY=

#   Storage bucket for food/menu images. Code default is "food-images".
SUPABASE_STORAGE_BUCKET=food-images

# -- Secrets (CANNOT be recovered from anywhere — see docs/10-env-recovery.md) --

# Signs FOUR different things: staff PIN sessions, master-admin sessions,
# guest order-track HMAC cookies, and (by fallback) the encryption key.
# Rotating it logs out every staff member and every admin at once.
#   Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# AES-256-GCM key protecting per-restaurant payment credentials AT REST in the
# database: eSewa merchant code + secret key, Khalti secret key, and bank
# account name/number/branch.
#
# >>> DANGER <<<
# If this value stops matching the one that encrypted the existing rows, every
# restaurant's gateway credentials become undecryptable and live payments break
# platform-wide. Read docs/10-env-recovery.md before changing it in production.
# Falls back to JWT_SECRET when unset — which is why JWT_SECRET must not be
# rotated casually either.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Platform master-admin login (/admin). Not a database user — checked directly
# against these two values in src/app/api/admin/login/route.ts.
MASTER_ADMIN_ID=
MASTER_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS — highest-consequence variables in the file
# -----------------------------------------------------------------------------
# These are ENDPOINT URLS ONLY. The actual merchant codes and secret keys are
# per-restaurant, stored encrypted in the PaymentConfig table — not here.
#
# The code defaults below fall back to SANDBOX. If these are unset in
# production, real money verifies against a test environment with no visible
# symptom. Both payment modules log "falling back to SANDBOX" at startup when
# that happens — grep production logs to confirm.
#
# Leave these BLANK for local development to stay on sandbox.

# Production: https://epay.esewa.com.np/api/epay/main/v2/form
# Sandbox   : https://rc-epay.esewa.com.np/api/epay/main/v2/form   (code default)
ESEWA_GATEWAY_URL=

# Production: https://epay.esewa.com.np/api/epay/transaction/status/
# Sandbox   : https://uat.esewa.com.np/api/epay/transaction/status/  (code default)
ESEWA_VERIFY_URL=

# Production: https://khalti.com/api/v2/epayment/initiate/
# Sandbox   : https://a.khalti.com/api/v2/epayment/initiate/        (code default)
KHALTI_GATEWAY_URL=

# Production: https://khalti.com/api/v2/epayment/lookup/
# Sandbox   : https://a.khalti.com/api/v2/epayment/lookup/          (code default)
KHALTI_VERIFY_URL=


# -----------------------------------------------------------------------------
# CRON — currently NOT set in production (see docs/10-env-recovery.md)
# -----------------------------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` on every scheduled
# invocation. Two routes read it, and they fail in OPPOSITE directions when it
# is missing:
#
#   /api/cron/expire-payments      -> guard is SKIPPED  -> publicly triggerable
#   /api/cron/purge-location-pings -> guard FAILS CLOSED -> job never runs
#
# Set this in Vercel (Production + Preview) to fix both at once.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=


# -----------------------------------------------------------------------------
# FIREBASE — push notifications
# -----------------------------------------------------------------------------
# Client config (public, ships in the browser bundle).
#   Source: Firebase console -> Project settings -> General -> Your apps -> SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web Push VAPID key. Without it getToken() throws and requestNotificationPermission()
# silently returns null — the browser never registers for push.
#   Source: Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates
#   NOT currently set in production.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Admin SDK service account (server side) — required to actually SEND a push.
# All three must be present or getMessaging() returns null and every
# notification silently no-ops.
#   Source: Firebase console -> Project settings -> Service accounts -> Generate new private key
#   NOT currently set in production — push notifications are dead in prod today.
#   FIREBASE_PRIVATE_KEY: paste the whole PEM in double quotes, keeping the
#   literal \n escapes. The code does .replace(/\\n/g, "\n").
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# OPTIONAL — degrade gracefully when absent
# -----------------------------------------------------------------------------

# Distributed rate limiting. Without both, rate limiting falls back to
# per-instance in-memory counters that reset on cold start — so the documented
# "5 attempts / 15 min" login limit is really 5 x (number of warm Lambdas).
# No code change needed; the library auto-detects at runtime.
#   Source: Upstash console -> your Redis database -> REST API
#   NOT currently set in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key for ID document OCR at /api/id-ocr.
# Absent -> the OCR endpoint is disabled.
#   Source: console.anthropic.com -> API keys (existing keys cannot be read
#   back; create a new one)
#   NOT currently set in production.
ANTHROPIC_API_KEY=

# Pexels image search for menu photos.
# Absent -> falls back to Openverse (lower quality results).
#   Source: pexels.com/api
PEXELS_API_KEY=

# S3-compatible Supabase Storage endpoint, for external tools only (AWS CLI,
# boto3). Unused by the app itself; defaults to "".
SUPABASE_S3_ENDPOINT=


# -----------------------------------------------------------------------------
# BUILD-MODE FLAGS — read docs/09-operations.md before touching these
# -----------------------------------------------------------------------------
# These control whether a deploy MUTATES THE LIVE DATABASE.
# Both must be absent/false for a normal deploy.

# Mode 2 — additive schema sync. Runs `prisma db push` WITHOUT --accept-data-loss.
# Safe by construction (refuses any destructive change), but still writes DDL to
# production. Set it, deploy, then UNSET IT AGAIN.
# ADDITIVE_SCHEMA_SYNC=true

# Mode 3 — destructive schema sync. Runs `prisma db push --accept-data-loss`.
# CAN DROP COLUMNS AND TABLES. One reviewed deploy only, then unset immediately.
# ALLOW_PRISMA_ACCEPT_DATA_LOSS=true
