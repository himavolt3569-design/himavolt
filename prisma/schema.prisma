// ─── Tutorial Videos (platform-wide, Master Admin authored) ────────
//
// Platform-level content, deliberately NOT scoped to a Restaurant: these are
// HimaVolt's own product walkthroughs, shown on the public landing page, in the
// dashboard, and in the post-signup prompt. Only MASTER_ADMIN may write them —
// note that `requireAdmin()` also admits PLATFORM_STAFF, so these routes use
// `requireMasterAdmin()` instead.

model TutorialCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  // Lucide icon name, resolved through an allowlist on the client.
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  videos TutorialVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("tutorial_categories")
}

model TutorialVideo {
  id          String  @id @default(cuid())
  title       String
  description String?

  // UPLOAD -> videoUrl is a Supabase public URL written by the signed-URL
  // direct-upload flow. EMBED -> videoUrl is the original pasted link and
  // provider/embedId carry the parsed identifiers.
  sourceType TutorialSource @default(UPLOAD)
  videoUrl   String
  posterUrl  String?
  provider   String?
  embedId    String?

  // Populated best-effort by the browser before upload. All nullable so a row
  // is never blocked on metadata extraction failing.
  durationSec  Int?
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  // Bytes before client-side compression, when the uploader compressed it.
  originalSize Int?

  audience   TutorialAudience @default(PUBLIC)
  sortOrder  Int              @default(0)
  isActive   Boolean          @default(true)
  // Exactly one video is normally featured — it is what the post-signup
  // "Watch the demo" prompt opens. Not enforced by a constraint; the write
  // path clears the previous feature flag.
  isFeatured Boolean          @default(false)
  viewCount  Int              @default(0)

  categoryId String
  category   TutorialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
  @@index([isActive, audience])
  @@index([isFeatured])
  @@map("tutorial_videos")
}

enum TutorialSource {
  UPLOAD
  EMBED
}

enum TutorialAudience {
  // Visible to everyone, including logged-out visitors on the landing page.
  PUBLIC
  // Requires any signed-in identity (owner, staff, or customer).
  AUTHENTICATED
}
