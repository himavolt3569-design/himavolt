  qrToken   String?  @unique // unguessable token encoded in the table QR so the table identity can't be spoofed via the URL
  label     String? // e.g. "Window Seat", "VIP 1"
  capacity  Int      @default(4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

