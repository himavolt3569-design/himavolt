// ─── Room Bookings ──────────────────────────────────────────────────

model RoomBooking {
  id                  String    @id @default(cuid())
  guestName           String
  guestPhone          String?
  guestEmail          String?
  guestAddress        String?
  guestIdType         String? // CITIZENSHIP, PASSPORT, etc.
  guestIdNumber       String?
  guestIdImageUrl     String? // uploaded ID proof (OCR source)
  adults              Int       @default(1)
  children            Int       @default(0)
  checkIn             DateTime
  checkOut            DateTime
  nights              Int       @default(1)
  totalPrice          Float     @default(0)
  roomServiceSelected Boolean   @default(false) // guest opted into the paid room-service add-on
  advanceAmount       Float     @default(0) // advance payment required
  advancePaid         Boolean   @default(false)
  // Advance payment details
  paymentMethod       String? // "ESEWA", "KHALTI", "CASH"
  paymentStatus       String    @default("UNPAID") // UNPAID, PAID, FAILED
  transactionId       String?
  pidx                String? // Khalti payment idx
  refId               String? // eSewa reference id
  receiptUrl          String? // guest-uploaded payment receipt (manual / QR pay)
  paidAt              DateTime?
  // PENDING (reserved, unpaid — auto-expires), CONFIRMED, CHECKED_IN,
  // CHECKED_OUT, CANCELLED
  status              String    @default("PENDING")
  // Cancellation / refund workflow
  cancelReason        String?
  cancelRequestedAt   DateTime?
  cancelledBy         String? // "CUSTOMER" | "HOTEL"
  refundStatus        String    @default("NONE") // NONE, REQUESTED, REFUNDED
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roomId       String
  room         Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Optional link to user (if customer is logged in)
  userId String?

  @@index([restaurantId])
  @@index([roomId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@map("room_bookings")
}

