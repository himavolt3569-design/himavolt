generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ─────────────────────────────────────────────────────────

model User {
  id            String    @id
  email         String    @unique
  name          String
  username      String?   @unique
  phone         String?
  imageUrl      String?
  role          UserRole  @default(CUSTOMER)
  hasPassword   Boolean   @default(true) @map("has_password")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")
  isBlacklisted Boolean   @default(false) @map("is_blacklisted")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedRestaurants Restaurant[]
  staffMemberships StaffMember[]
  orders           Order[]
  reviews          Review[]
  fcmTokens        FCMToken[]
  auditLogs        AuditLog[]
  menuItemRatings  MenuItemRating[]
  favourites       Favourite[]
  loyaltyAccounts  LoyaltyAccount[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

// ─── Restaurants ───────────────────────────────────────────────────

model Restaurant {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  restaurantCode String?        @unique // Added for staff login (e.g. HH-1A2B)
  phone          String
  countryCode    String         @default("+977")
  type           RestaurantType
  address        String
  city           String         @default("Kathmandu")
  latitude       Float?
  longitude      Float?
  imageUrl       String?
  coverUrl       String?
  isActive       Boolean        @default(true)
  tableCount     Int            @default(8)
  // LEGACY — superseded by `RestaurantHours` (per-day, per-service, overnight-capable).
  // Kept readable for one release so old code paths don't break; retire in a later
  // destructive deploy. New code must go through getRestaurantOperationalStatus().
  openingTime    String         @default("09:00")
  closingTime    String         @default("23:00")
  // IANA identifier — never an abbreviation. Every "is it open now" calculation
  // resolves against THIS, never the server clock. Vercel runs UTC; Nepal is +05:45.
  timezone       String         @default("Asia/Kathmandu")
  rating         Float          @default(0)
  totalOrders    Int            @default(0)
  roomCount      Int            @default(0) // for GUEST_HOUSE, HOTEL, RESORT

  // WiFi details (shown on menu page)
  wifiName     String?
  wifiPassword String?

  // Currency & Tax config
  currency             String  @default("NPR") // NPR, INR, USD
  taxRate              Float   @default(13) // percentage, e.g. 13 = 13%
  taxEnabled           Boolean @default(true)
  serviceChargeRate    Float   @default(10) // percentage, e.g. 10 = 10%
  serviceChargeEnabled Boolean @default(true)

  // Printing & receipts — set once in the dashboard, applied to every printout
  printCounterWidth     Int     @default(80) // mm — customer bill + POS counter receipt
  printKitchenWidth     Int     @default(80) // mm — KOT + BOT (kitchen/bar tickets)
  // LEGACY — the logo option was removed from bills and receipts; nothing reads
  // this any more. Kept so the column is not dropped from the live database
  // (a destructive change needing ALLOW_PRISMA_ACCEPT_DATA_LOSS). Retire in a
  // deliberate destructive deploy.
  printShowLogo         Boolean @default(true)
  printShowFeedbackQR   Boolean @default(true) // show feedback QR on the customer bill
  printAutoReceipt      Boolean @default(false) // auto-print the customer receipt as soon as a bill is settled
  printAutoKOT          Boolean @default(false) // auto-print the kitchen ticket (KOT) when staff accepts an order
  // Auto-print the PROVISIONAL bill when staff accepts an order. Deliberately
  // separate from `printAutoReceipt`: that one fires at settlement and prints the
  // tax invoice, this one fires at accept and prints an unpaid pre-bill. Both on
  // means two slips per order — the settings UI says so out loud.
  // Order-type aware at the call site: dine-in tables print a KOT instead, since
  // a running tab is billed once at the end, not once per round.
  printAutoBillOnAccept Boolean @default(false)

  // Operational status (staff-controllable). `isOpen` is the manual override and
  // WINS over any computed schedule — it is how a venue closes unexpectedly.
  isOpen          Boolean @default(true) // when false, hidden from landing page & ordering disabled
  // LEGACY — superseded by `RestaurantCapability.deliveryEnabled`. Kept readable
  // for one release; backfilled into the capability row. Retire in a later deploy.
  deliveryEnabled Boolean @default(false) // when true, delivery option shown in checkout

  // Prepaid mode
  prepaidEnabled    Boolean @default(false) // if true, customers must pay before food processing begins
  counterPayEnabled Boolean @default(true) // counter pay available for all types
  directPayEnabled  Boolean @default(false) // direct bank/wallet pay

  // POS activation (Phase 1)
  posEnabled             Boolean   @default(false) // master switch: when true, /pos/staff & kiosk are accessible
  posActivatedAt         DateTime? // when POS was first activated
  posTerminalName        String? // friendly label shown on POS header, e.g. "Front Counter"
  posOpeningCash         Float     @default(0) // default cash drawer opening balance (NPR)
  posWelcomeSeenAt       DateTime? // when the owner dismissed the first-time welcome guide
  posCustomerModeEnabled Boolean   @default(true) // allow staff to flip into customer-facing kiosk mode
  // Customer-mode hardware-button exit combo. JSON shape:
  //   { "ctrl": true, "shift": true, "alt": false, "key": "x" }
  // Default (Ctrl+Shift+X) applied at the API layer when null.
  posCustomerExitCombo   Json?

  // Hotel / Resort / Guest House booking advance config
  hotelAdvanceType  String @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  hotelAdvanceValue Float  @default(30) // 30 = 30% of total, or NPR fixed amount

  // Room Service add-on (Hotel Hub). Optional paid service a guest can opt into
  // when booking; the flat charge is added to the booking total.
  roomServiceEnabled Boolean @default(false)
  roomServiceCharge  Float   @default(0)

  // Master-admin feature overrides (keyed by FeatureTabId).
  // Force-enable a feature even if the type doesn't include it by default.
  featuresEnabled  String[] @default([])
  // Force-disable a feature even if the type includes it by default.
  featuresDisabled String[] @default([])

  // Dynamic theme (set by owner/admin via ThemeSettingsTab)
  primaryColor   String? // hex e.g. "#eaa94d"
  secondaryColor String?
  accentColor    String?
  fontFamily     String? // "Inter" | "Poppins" | "Lato" | etc.
  menuLayout     String  @default("grid") // "grid" | "list" | "compact"
  footerText     String?
  showStories    Boolean @default(true)
  showReviews    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  staff                     StaffMember[]
  categories                MenuCategory[]
  menuItems                 MenuItem[]
  orders                    Order[]
  reviews                   Review[]
  chatRooms                 ChatRoom[]
  inventory                 InventoryItem[]
  stories                   Story[]
  deliveryZones             DeliveryZone[]
  auditLogs                 AuditLog[]
  paymentQRs                PaymentQR[]
  paymentConfig             PaymentConfig?
  heroSlides                HeroSlide[]
  tableSessions             TableSession[]
  tables                    Table[]
  favourites                Favourite[]
  guestCheckIns             GuestCheckIn[]
  media                     Media[]
  rooms                     Room[]
  roomBookings              RoomBooking[]
  coupons                   Coupon[]
  prepaidTokens             PrepaidToken[]
  feedbacks                 Feedback[]
  comboMeals                ComboMeal[]
  rushHourConfig            RushHourConfig?
  displayCounterItems       DisplayCounterItem[]
  displayCounterConfig      DisplayCounterConfig?
  shifts                    Shift[]
  happyHours                HappyHour[]
  reservations              Reservation[]
  loyaltyConfig             LoyaltyConfig?
  loyaltyRewards            LoyaltyReward[]
  loyaltyAccounts           LoyaltyAccount[]
  printJobs                 PrintJob[]
  featureConfigs            FeatureConfig[]
  expenses                  Expense[]
  capability                RestaurantCapability?
  hours                     RestaurantHours[]
  specialHours              RestaurantSpecialHours[]
  deliveryDrivers           DeliveryDriver[]
  platformStaffTenantScopes PlatformStaffTenantScope[]

  @@index([ownerId])
  @@index([slug])
  // Bounding-box prefilter for proximity discovery (findNearbyRestaurants).
  @@index([latitude, longitude])
  // Public discovery filters on all three before any distance maths runs.
  @@index([isActive, isOpen])
  @@map("restaurants")
}

// ─── Fulfilment capabilities ───────────────────────────────────────
// What a restaurant CAN DO, as opposed to what it IS (`Restaurant.type`).
// A Cafe, Bar, Hotel or Bakery may all deliver — never branch on `type`.
//
// Deliberately separate from `Restaurant.featuresEnabled/featuresDisabled` and
// `FeatureConfig`: those are the UI-NAVIGATION axis (which dashboard tabs render).
// This is the FULFILMENT axis, queried in SQL by public discovery. Keep the two
// apart or this becomes a third overlapping system. → docs/07-features-and-tenancy.md

model RestaurantCapability {
  id                  String  @id @default(cuid())
  dineInEnabled       Boolean @default(true)
  pickupEnabled       Boolean @default(false)
  deliveryEnabled     Boolean @default(false)
  codEnabled          Boolean @default(false)
  codMaxAmount        Float   @default(2000) // NPR ceiling for cash-on-delivery
  liveTrackingEnabled Boolean @default(false)
  deliveryRadiusKm    Float   @default(5)
  deliveryPrepMins    Int     @default(30) // kitchen time, feeds the customer ETA
  mergeBillingOrders  Boolean @default(false) // Unified Orders & Billing staff UI
  // Accept incoming orders the instant they land — no pending queue, no timer.
  // Trades the human stock/availability check for the guarantee that an order
  // can never strand unaccepted. Applied post-commit in the order route, never
  // inside the creation transaction.
  autoAcceptOrders    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_capabilities")
}

// ─── Operating hours ───────────────────────────────────────────────
// Three layers, in precedence order (highest first):
//   1. `Restaurant.isOpen = false`  → manually closed, beats everything
//   2. `RestaurantSpecialHours`     → date-specific override (holiday, event)
//   3. `RestaurantHours`            → the weekly recurring schedule
// All resolved by getRestaurantOperationalStatus() — the single entry point.

enum ServiceType {
  DINE_IN
  DELIVERY
  PICKUP
}

model RestaurantHours {
  id          String      @id @default(cuid())
  serviceType ServiceType
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  isClosed    Boolean     @default(false)
  // Minutes from midnight in the RESTAURANT's timezone, not the server's.
  openMin     Int // 0–1439
  // May exceed 1440 to encode an overnight shift in ONE row: 18:00–02:00 is
  // openMin 1080, closeMin 1560. The schema.org/OSM convention of splitting into
  // two rows ending at 23:59 is equally correct but miserable to render and edit.
  closeMin    Int // 1–2880

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, serviceType, dayOfWeek])
  @@index([restaurantId, serviceType])
  @@map("restaurant_hours")
}

// Scope of a date override. `ALL` is a real enum value rather than a NULL
// `serviceType` for a concrete reason: Postgres treats NULLs as distinct inside a
// unique constraint, so `@@unique([restaurantId, date, serviceType])` with a
// nullable column would happily accept unlimited "applies to everything" rows for
// the same date — the exact duplicate the constraint exists to prevent. It also
// makes the row upsertable, which a nullable composite key is not.
enum SpecialHoursScope {
  ALL
  DINE_IN
  DELIVERY
  PICKUP
}

model RestaurantSpecialHours {
  id          String            @id @default(cuid())
  date        DateTime          @db.Date
  serviceType SpecialHoursScope @default(ALL)
  isClosed    Boolean           @default(false)
  openMin     Int? // null when isClosed
  closeMin    Int? // null when isClosed; same >1440 overnight rule
  reason      String? // Holiday · Maintenance · Private event

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date, serviceType])
  @@index([restaurantId, date])
  @@map("restaurant_special_hours")
}

// ─── Feature-tab persistence ───────────────────────────────────────
// Generic per-restaurant, per-feature config store. Each dashboard feature tab
// (Brunch Mode, Happy Hours, Waitlist, …) saves its whole editable state as a
// single JSON blob keyed by a stable featureId, so we get durable persistence
// for every feature without a bespoke table per feature.

model FeatureConfig {
  id           String   @id @default(cuid())
  restaurantId String
  featureId    String // stable slug, e.g. "brunch-mode", "happy-hours"
  data         Json // the feature tab's saved state
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, featureId])
  @@index([restaurantId])
  @@map("feature_configs")
}

// ─── Inventory / Stock ─────────────────────────────────────────────

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  unit        String   @default("kg") // kg, litre, pcs, packs, etc.
  quantity    Float    @default(0)
  minStock    Float    @default(5) // alert threshold
  costPerUnit Float    @default(0)
  category    String   @default("General") // Vegetables, Spices, Meat, Drinks, etc.
  notes       String?
  imageUrl    String? // optional product photo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Drink-specific fields
  isDrink       Boolean @default(false)
  drinkCategory String? // "Soft Drinks", "Hard Drinks", "Alcohol"
  sellingPrice  Float? // price when sold as menu item

  // Stock-to-menu link: should this item appear on the customer menu?
  showOnMenu Boolean @default(false)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems MenuItemIngredient[]

  @@index([restaurantId])
  @@index([restaurantId, isDrink])
  @@map("inventory_items")
}

// Operating expenses / costs the owner records, so the app can produce a real
// Profit & Loss (revenue is derived from paid orders; this is the cost side).
enum ExpenseCategory {
  INGREDIENTS // food/drink purchases (cost of goods)
  SALARIES // staff wages & salaries
  RENT
  UTILITIES // electricity, water, gas, internet
  MARKETING
  EQUIPMENT // equipment & furniture
  MAINTENANCE // repairs & cleaning
  SUPPLIES // packaging & consumables
  OTHER
}

model Expense {
  id         String          @id @default(cuid())
  category   ExpenseCategory @default(OTHER)
  amount     Float
  note       String?
  // The date the expense applies to (owner-set) — P&L buckets by this, not by
  // when the row happened to be entered.
  incurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, incurredAt])
  @@map("expenses")
}

// ─── Payment QR Images ───────────────────────────────────────────

model PaymentQR {
  id        String   @id @default(cuid())
  label     String // e.g. "eSewa", "Khalti", "Fonepay", "Bank QR"
  imageUrl  String // uploaded QR image URL
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("payment_qrs")
}

// ─── Per-Restaurant Payment Configuration ────────────────────────

model PaymentConfig {
  id String @id @default(cuid())

  // Which payment methods are enabled
  cashEnabled   Boolean @default(true)
  esewaEnabled  Boolean @default(false)
  khaltiEnabled Boolean @default(false)
  bankEnabled   Boolean @default(false)

  // eSewa credentials (encrypted)
  esewaMerchantCode String?
  esewaSecretKey    String?

  // Khalti credentials (encrypted)
  khaltiSecretKey String?

  // Bank transfer details
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranch        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payment_configs")
}

enum RestaurantType {
  FAST_FOOD
  RESORT
  HOTEL
  BAKERY
  CLOUD_KITCHEN
  BAR
  CAFE
  RESTAURANT
  MO_MO_SHOP
  TANDOORI
  GUEST_HOUSE
  SWEETS
}

// ─── Staff ─────────────────────────────────────────────────────────

model StaffMember {
  id        String    @id @default(cuid())
  pin       String
  qrToken   String?   @unique @map("qr_token")
  role      StaffRole
  staffType StaffType @default(SHIFT_BASED)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  attendance      StaffAttendance[]
  stories         Story[]
  media           Media[]
  shifts          Shift[]
  processedOrders Order[]           @relation("ProcessedOrders")

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("staff_members")
}

model StaffAttendance {
  id       String    @id @default(cuid())
  date     DateTime  @db.Date
  checkIn  DateTime
  checkOut DateTime?
  status   String    @default("PRESENT") // PRESENT, LATE, etc.

  staffId String
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId])
  @@map("staff_attendance")
}

model Shift {
  id            String    @id @default(cuid())
  label         String?
  date          DateTime  @db.Date
  startTime     String // "HH:mm" 24-hour format
  endTime       String // "HH:mm" 24-hour format
  actualEndTime DateTime? // set when staff clocks out early
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staffId      String
  staff        StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@index([staffId])
  @@map("shifts")
}

enum StaffRole {
  SUPER_ADMIN
  MANAGER
  CHEF
  WAITER
  CASHIER
}

enum StaffType {
  FULL_TIME
  SHIFT_BASED
}

// ─── Menu ──────────────────────────────────────────────────────────

model MenuCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String
  icon      String? // emoji or icon name
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  parentId String?
  parent   MenuCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuCategory[] @relation("CategoryHierarchy")

  items MenuItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([parentId])
  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(cuid())
  name           String
  description    String
  price          Float
  imageUrl       String?
  rating         Float    @default(0)
  prepTime       String   @default("15-20 min")
  isVeg          Boolean  @default(false)
  hasEgg         Boolean  @default(false)
  hasOnionGarlic Boolean  @default(true)
  isAvailable    Boolean  @default(true)
  badge          String?
  tags           String[] @default([])
  sortOrder      Int      @default(0)
  discount       Float    @default(0) // percentage off (e.g. 20 = 20% off)
  discountLabel  String? // display text e.g. "FLAT Rs.100 OFF"
  isFeatured     Boolean  @default(false) // starred/highlighted by restaurant
  spiceLevel     Int      @default(0) // 0=none, 1=mild, 2=medium, 3=hot, 4=extra-hot
  calories       Int? // kcal per serving
  allergens      String[] @default([]) // e.g. ["gluten","dairy","nuts"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Drinks tracking
  isDrink       Boolean @default(false)
  drinkCategory String? // "COLD" | "HOT" | "ALCOHOL"
  stockEnabled  Boolean @default(false) // track stock for this item
  stockQuantity Float   @default(0) // current stock count
  bottleCount   Int? // drinks: number of bottles in stock (Phase 2)
  volumeMl      Int? // drinks: volume per serving/bottle in ml (Phase 2)

  offerExpiresAt DateTime?
  offerStartedAt DateTime?

  sizes       MenuItemSize[]
  addOns      MenuItemAddOn[]
  orderItems  OrderItem[]
  ratings     MenuItemRating[]
  heroSlides  HeroSlide[]
  ingredients MenuItemIngredient[]
  comboItems  ComboMealItem[]
  favourites  Favourite[]

  @@index([restaurantId])
  @@index([categoryId])
  // Composite indexes for the hottest list queries:
  //   • menu listing per restaurant filters on isAvailable
  //   • food-detail "related" query filters on (categoryId, isAvailable)
  //   • food-detail "trending" query filters on (restaurantId, isFeatured)
  //   • landing-page top-rated filters on (restaurantId, rating)
  @@index([restaurantId, isAvailable])
  @@index([categoryId, isAvailable])
  @@index([restaurantId, isFeatured])
  @@index([restaurantId, rating])
  @@map("menu_items")
}

model MenuItemSize {
  id       String @id @default(cuid())
  label    String
  grams    String
  priceAdd Float  @default(0)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_sizes")
}

model MenuItemAddOn {
  id    String @id @default(cuid())
  name  String
  price Float

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_addons")
}

// ─── Orders ────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  orderNo      String      @unique
  tableNo      Int?
  roomNo       String? // guest house room number
  guestName    String? // for counter/manual orders without an account
  status       OrderStatus @default(PENDING)
  subtotal     Float
  tax          Float       @default(0)
  total        Float
  note         String?
  type         OrderType   @default(DINE_IN)
  acceptedAt   DateTime?
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Delivery fields
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryPhone   String?
  deliveryNote    String?
  deliveryFee     Float   @default(0)

  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Staff who processed/created this order (set from JWT session)
  processedByStaffId String?
  processedByStaff   StaffMember? @relation("ProcessedOrders", fields: [processedByStaffId], references: [id], onDelete: SetNull)

  // Prepaid flow
  isPrepaid      Boolean @default(false) // order requires payment before processing
  prepaidTokenId String? @unique // link to PrepaidToken once paid

  // POS hold/recall
  isHeld Boolean   @default(false)
  heldAt DateTime?

  // Coupon
  couponId       String?
  couponDiscount Float   @default(0) // discount amount applied from coupon

  // ── Production order pipeline (Phase 2.5) — all additive/nullable ──
  // `status`, `acceptedAt`, `rejectReason` above are reused, not duplicated.
  sourceType     String? // TABLE_QR | HOTEL_ROOM_QR | POS | STAFF
  trackToken     String?   @unique // opaque public tracking token (/order-track/[trackToken])
  idempotencyKey String? // restaurant-scoped duplicate-submit guard (see @@unique below)
  kitchenStatus  String? // PENDING|ACCEPTED|REJECTED|PREPARING|READY|SERVED (layers on top of status)
  rejectedAt     DateTime?
  printedAt      DateTime?
  roomBookingId  String? // links a HOTEL_ROOM_QR order to its RoomBooking

  items        OrderItem[]
  prepGroups   OrderPreparationGroup[]
  payment      Payment?
  bill         Bill?
  chatRoom     ChatRoom?
  delivery     Delivery?
  tableSession TableSession?
  prepaidToken PrepaidToken?           @relation(fields: [prepaidTokenId], references: [id])
  feedbacks    Feedback[]
  printJobs    PrintJob[]

  // Restaurant-scoped idempotency (NOT global): a duplicate submit with the same
  // (restaurantId, idempotencyKey) returns the existing order. NULLs are distinct
  // in Postgres, so existing all-NULL rows never collide.
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([processedByStaffId])
  // Hot composite for the kitchen / live-orders SSE stream which filters on
  // (restaurantId, status) and orders by createdAt every poll.
  @@index([restaurantId, status, createdAt])
  // Customer-side "my orders" view filters by (userId, createdAt desc).
  @@index([userId, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// This IS the fulfilment type. `TAKEAWAY` ≡ PICKUP — see src/lib/fulfilment.ts
// for the aliases. Only `DELIVERY` may create a `Delivery` row.
enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

// Canonical kitchen lifecycle. `Order.kitchenStatus` / `OrderItem.kitchenStatus`
// are still free-form strings carrying exactly these values on a hot production
// table — they are typed at the TS boundary (src/lib/orders/kitchen-status.ts)
// and converted to this column type in a later dedicated deploy. New tables use
// the enum directly.
enum KitchenStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  SERVED
}

// Which station prepares an item. Routing is derived from MenuItem.isDrink /
// drinkCategory at order time — the same rule every commercial KDS uses.
enum PrepStation {
  FOOD
  DRINKS
  BAR
  DESSERT
}

// Splits one order into per-station tickets so the kitchen and the bar can work
// in parallel WITHOUT either being able to ship the order alone. An order with a
// burger and a Coke has two groups; it only becomes READY_FOR_PICKUP when both
// are complete. That gate lives in the delivery state machine, never in a component.
model OrderPreparationGroup {
  id      String        @id @default(cuid())
  station PrepStation
  status  KitchenStatus @default(PENDING)
  readyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([orderId, station])
  @@index([orderId])
  @@map("order_preparation_groups")
}

model OrderItem {
  id       String  @id @default(cuid())
  name     String
  quantity Int
  price    Float
  addOns   String?

  // Round marker: all items submitted together (initial order or one add-on
  // batch) share this timestamp, set explicitly in code per batch. Lets the
  // kitchen/live boards reconstruct ordering "rounds" and surface a new add-on
  // round distinctly. @default(now()) only backfills legacy rows.
  createdAt DateTime @default(now())

  // ── Per-item kitchen status (Phase 2.5) — additive/nullable ──
  kitchenStatus    String? // PENDING|ACCEPTED|REJECTED|PREPARING|READY|SERVED
  rejectedReason   String?
  preparedAt       DateTime?
  servedAt         DateTime?
  // Snapshot of MenuItem.prepTime at order time, so the customer tracking page
  // shows the prep time that was configured when the order was placed (a later
  // menu edit must not retroactively change an existing order). Populated in 2.5c.
  prepTimeSnapshot String?

  orderId     String
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem?              @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  prepGroupId String?
  prepGroup   OrderPreparationGroup? @relation(fields: [prepGroupId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([prepGroupId])
  @@map("order_items")
}

// ─── Payments ───────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  transactionId String?
  pidx          String? // Khalti payment idx
  refId         String? // eSewa/bank reference
  metadata      String? // JSON string for extra gateway data
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Bank transfer verification
  proofUrl        String? // bank transfer proof screenshot URL
  proofUploadedAt DateTime?
  verifiedBy      String? // staff member ID who verified
  verifiedAt      DateTime?
  rejectionNote   String? // reason if bank payment rejected

  // Duplicate-initiation guard. Refreshing checkout or double-tapping "Pay" must
  // not create a second payment. Mirrors Order.idempotencyKey — restaurant scope
  // is unnecessary here because the key is already order-scoped via the unique.
  idempotencyKey String? @unique

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

enum PaymentMethod {
  ESEWA
  KHALTI
  BANK
  CASH
  COUNTER
  DIRECT
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION // bank proof uploaded, awaiting biller review
  COMPLETED
  FAILED
  CANCELLED // order cancelled by customer
  REFUND_PENDING // refund owed, awaiting manual payout (no eSewa/Khalti refund API here)
  REFUNDED
  EXPIRED // payment timed out
}

// ─── Bills / Invoices ───────────────────────────────────────────────

model Bill {
  id            String   @id @default(cuid())
  billNo        String   @unique
  subtotal      Float
  tax           Float
  serviceCharge Float    @default(0)
  discount      Float    @default(0)
  total         Float
  paidVia       String?
  createdAt     DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  printJobs PrintJob[]

  @@map("bills")
}

// ─── Print Outbox (Phase 2.5) ───────────────────────────────────────
// Durable KOT/BILL print jobs so printing survives a closed kitchen tab and
// supports atomic claim (PENDING → PRINTING) to avoid double-printing.
model PrintJob {
  id           String    @id @default(cuid())
  restaurantId String
  orderId      String?
  billId       String?
  type         String // KOT | BILL
  status       String    @default("PENDING") // PENDING|PRINTING|PRINTED|FAILED|RETRYING
  payload      Json
  attempts     Int       @default(0)
  lastError    String?
  claimedBy    String? // print-client id that owns the current attempt
  claimedAt    DateTime?
  lockedUntil  DateTime? // claim lease expiry, so a dead client's job can be reclaimed
  printedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bill       Bill?      @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([status, lockedUntil])
  @@index([orderId])
  @@index([billId])
  @@map("print_jobs")
}

// ─── FCM Tokens ─────────────────────────────────────────────────────

model FCMToken {
  id        String   @id @default(cuid())
  token     String   @unique
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

// ─── Reviews ───────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("reviews")
}

// ─── Chat ───────────────────────────────────────────────────────────

model ChatRoom {
  id        String       @id @default(cuid())
  type      ChatRoomType @default(CUSTOMER)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orderId      String?    @unique // null for internal/broadcast channels
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Pre-order table/room chat fields
  tableNo Int?
  roomNo  String?

  messages ChatMessage[]

  @@index([restaurantId])
  @@index([restaurantId, type])
  @@index([restaurantId, tableNo, isActive])
  @@index([restaurantId, roomNo, isActive])
  @@map("chat_rooms")
}

enum ChatRoomType {
  CUSTOMER // per-order customer chat
  BROADCAST // admin-to-all-staff channel
  TABLE_CHAT // pre-order per-table chat
}

model ChatMessage {
  id         String     @id @default(cuid())
  content    String
  sender     ChatSender
  senderName String?
  createdAt  DateTime   @default(now())

  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  userId     String?

  @@index([chatRoomId])
  @@index([createdAt])
  @@map("chat_messages")
}

enum ChatSender {
  CUSTOMER
  KITCHEN
  BILLING
  ADMIN
  MANAGER
}

// ─── Stories ────────────────────────────────────────────────────────

model Story {
  id        String    @id @default(cuid())
  type      StoryType @default(IMAGE)
  mediaUrl  String
  caption   String?
  isActive  Boolean   @default(true)
  expiresAt DateTime // auto-expire after 24h
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  staffId String?
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("stories")
}

enum StoryType {
  IMAGE
  VIDEO
}

// ─── Audit Logs ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. ORDER_CREATED, MENU_ITEM_UPDATED, STAFF_ADDED
  entity    String // e.g. Order, MenuItem, StaffMember
  entityId  String? // ID of the affected record
  detail    String? // Human-readable summary of what happened
  metadata  String? // JSON string with extra context (old/new values, etc.)
  ipAddress String?
  createdAt DateTime @default(now())

  // Who performed the action
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  restaurantId    String?
  restaurant      Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  platformStaffId String?
  platformStaff   PlatformStaff? @relation(fields: [platformStaffId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([restaurantId])
  @@index([platformStaffId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Contact Submissions ───────────────────────────────────────────

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

// ─── Delivery ──────────────────────────────────────────────────────

model DeliveryDriver {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  imageUrl    String?
  vehicleType String   @default("BIKE") // BIKE, SCOOTER, CAR, BICYCLE
  vehicleNo   String?
  licenseNo   String?
  isActive    Boolean  @default(true)
  isOnline    Boolean  @default(false)
  currentLat  Float?
  currentLng  Float?
  rating      Float    @default(5.0)
  totalTrips  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // TENANCY: riders belong to one restaurant. Without this the table is global
  // and Restaurant A can read Restaurant B's riders — there is no RLS backstop.
  // Nullable only so existing rows (there are none in practice) can backfill.
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  deliveries Delivery[]

  @@index([isActive, isOnline])
  @@index([restaurantId])
  @@map("delivery_drivers")
}

model Delivery {
  id            String         @id @default(cuid())
  status        DeliveryStatus @default(PENDING)
  pickupLat     Float?
  pickupLng     Float?
  dropoffLat    Float?
  dropoffLng    Float?
  distanceKm    Float?
  estimatedMins Int?
  actualMins    Int?
  fee           Float          @default(0)
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // ── Pricing snapshot ──────────────────────────────────────────────
  // `DeliveryZone` is CONFIGURATION and changes over time. A completed order must
  // always show the price charged that day, so the whole breakdown is frozen here
  // at order time by computeDeliveryFee(). NEVER recompute a historical fee.
  // `fee` above stays the settled total; these are the audit detail behind it.
  baseFeeSnap   Float?
  distanceFee   Float?
  discountSnap  Float?
  finalFee      Float?
  pricingZoneId String? // which DeliveryZone produced the numbers
  pricedAt      DateTime?

  // Account-less rider link (/rider/[riderToken]) — same pattern as
  // Order.trackToken and HardwareListing.manageToken. Scopes the actor to this
  // one delivery, so a rider can never touch another order.
  riderToken String? @unique

  orderId  String          @unique
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId String?
  driver   DeliveryDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  locationPings DriverLocationPing[]

  @@index([status])
  @@index([driverId])
  @@map("deliveries")
}

// Per-delivery location history, NOT a single moving pointer on the driver.
// A driver runs many deliveries: `DeliveryDriver.currentLat/Lng` alone loses
// history, makes disputes unresolvable and makes retention harder to reason about.
// RETENTION: purged 7 days after the delivery reaches a terminal state.
model DriverLocationPing {
  id         String   @id @default(cuid())
  latitude   Float
  longitude  Float
  accuracyM  Float?
  recordedAt DateTime @default(now())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId   String?

  @@index([deliveryId, recordedAt])
  @@map("driver_location_pings")
}

// The DELIVERY LEG only. Payment lives in `Payment.status`, acceptance in
// `Order.status`, kitchen progress in `Order.kitchenStatus`. A fourth enum
// re-encoding those would give four sources of truth — getOrderFulfilmentState()
// composes them instead. Values are additive; existing rows keep their meaning.
enum DeliveryStatus {
  PENDING // order placed, kitchen not finished yet
  READY_FOR_PICKUP // every preparation group complete, awaiting a rider
  ASSIGNED // driver assigned, heading to restaurant
  PICKED_UP // driver has the food
  IN_TRANSIT // on the way to customer
  DELIVERED // dropped off — terminal
  CANCELLED // cancelled before dispatch — terminal
  FAILED // customer unreachable / address wrong — terminal
  RETURNED // food came back to the restaurant — terminal
}

// ─── Delivery Zones ────────────────────────────────────────────────

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String // e.g. "Kathmandu Valley"
  baseFee     Float    @default(50) // base delivery charge
  perKmFee    Float    @default(15) // per km charge
  freeAbove   Float? // free delivery above this order total
  maxRadiusKm Float    @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("delivery_zones")
}

// ─── Food Ratings ────────────────────────────────────────────────

model MenuItemRating {
